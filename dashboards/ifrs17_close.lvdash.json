{
 "datasets": [
  {
   "name": "ds_isr",
   "displayName": "Insurance service result by quarter",
   "queryLines": [
    "SELECT close_period, amount FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_pnl_statement WHERE line_item = 'Insurance service result' ORDER BY close_period"
   ]
  },
  {
   "name": "ds_revenue",
   "displayName": "Insurance revenue by component",
   "queryLines": [
    "SELECT close_period, component, ROUND(SUM(amount),0) amount FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_insurance_revenue GROUP BY 1,2 ORDER BY 1,2"
   ]
  },
  {
   "name": "ds_groups",
   "displayName": "Groups at the current close",
   "queryLines": [
    "SELECT group_id, measurement_model, ROUND(bs_lrc_total,0) bs_lrc_total, ROUND(csm,0) csm, ROUND(loss_component,0) loss_component, onerous FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_cohort_360 ORDER BY bs_lrc_total DESC"
   ]
  },
  {
   "name": "ds_headroom",
   "displayName": "Onerous headroom trend",
   "queryLines": [
    "SELECT close_period, group_id, ROUND(headroom,0) headroom FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_onerous_test WHERE group_id LIKE 'PROP%' OR group_id LIKE 'MOT%' ORDER BY close_period"
   ]
  },
  {
   "name": "ds_lic",
   "displayName": "LIC closing by portfolio",
   "queryLines": [
    "SELECT close_period, portfolio_id, ROUND(SUM(amount),0) lic_closing FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_lic_rollforward WHERE step='closing' GROUP BY 1,2 ORDER BY 1,2"
   ]
  },
  {
   "name": "ds_csm",
   "displayName": "CSM closing by group",
   "queryLines": [
    "SELECT close_period, group_id, ROUND(SUM(amount),0) csm_closing FROM lr_dev_aws_us_catalog.ifrs17_workbench.gld_csm_rollforward WHERE step='closing' GROUP BY 1,2 ORDER BY 1,2"
   ]
  }
 ],
